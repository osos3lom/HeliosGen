# HeliosGen is a static web app: API keys are entered in Settings → API Keys and
# stay in your browser (IndexedDB). Never put keys here — anything in a VITE_*
# variable is compiled into the public bundle.

# Show the Settings → Debug panel (verbose request logging).
VITE_DEBUG=

# Base path the app is served from. GitHub Pages project sites use /<repo>/;
# the deploy workflow sets this automatically. Leave empty for local dev.
VITE_BASE=
